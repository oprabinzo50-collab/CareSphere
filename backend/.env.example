# CareSphere — $0 deployment example
# Put real values only in the hosting provider's secret/environment settings.

APP_NAME=CareSphere
APP_VERSION=0.1.0

# Neon PostgreSQL connection string
# Paste the exact pooled or direct connection string supplied by Neon.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# JWT authentication
# Render can generate SECRET_KEY automatically. Do not commit a real secret.
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Browser origin(s), comma-separated.
# Update this after Cloudflare Pages gives you the final *.pages.dev URL.
CORS_ORIGINS=https://YOUR-PAGES-PROJECT.pages.dev

# AI — use Gemini's free tier.
AI_ENABLED=true
AI_PROVIDER=gemini
AI_MODEL=gemini-3.8-flash
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_TIMEOUT_SECONDS=30
AI_MAX_OUTPUT_TOKENS=1200
