from datetime import datetime, timezone

from fastapi import APIRouter, Depends, HTTPException, Query, status
from sqlalchemy import select
from sqlalchemy.orm import Session

from app.database import SessionLocal
from app.models.patient import Patient
from app.models.patient_user_links import PatientUserLink
from app.models.user import User
from app.schemas.user import UserCreate, UserResponse, UserStatusUpdate, UserUpdate
from app.security.password import hash_password
from app.security.permissions import require_permission
from app.security.roles import SUPPORTED_ROLES, normalize_role

router = APIRouter(prefix="/users", tags=["Users"])


def get_db():
    db = SessionLocal()
    try:
        yield db
    finally:
        db.close()


def resolve_patient_link(db: Session, user_id: int) -> int | None:
    link = db.scalar(select(PatientUserLink).where(PatientUserLink.user_id == user_id))
    return link.patient_id if link else None


def ensure_patient_link(db: Session, user_id: int, patient_id: int | None):
    existing = db.scalar(select(PatientUserLink).where(PatientUserLink.user_id == user_id))
    if patient_id is None:
        if existing:
            db.delete(existing)
        return

    patient = db.get(Patient, patient_id)
    if patient is None:
        raise HTTPException(status_code=404, detail="Patient not found")

    conflicting = db.scalar(
        select(PatientUserLink).where(
            PatientUserLink.patient_id == patient_id,
            PatientUserLink.user_id != user_id,
        )
    )
    if conflicting:
        raise HTTPException(status_code=409, detail="Patient is already linked to another patient portal account")

    if existing:
        existing.patient_id = patient_id
        return

    db.add(PatientUserLink(
        user_id=user_id,
        patient_id=patient_id,
        created_at=datetime.now(timezone.utc),
    ))


def validate_role(role: str) -> str:
    normalized = normalize_role(role)
    if normalized not in SUPPORTED_ROLES:
        raise HTTPException(
            status_code=400,
            detail="role must be administrator, clinician, or patient",
        )
    return normalized


def serialize_user(user: User, db: Session) -> UserResponse:
    return UserResponse(
        id=user.id,
        username=user.username,
        full_name=user.full_name,
        role=normalize_role(user.role),
        status=user.status,
        created_at=user.created_at,
        updated_at=user.updated_at,
        last_login_at=user.last_login_at,
    )


@router.get("", response_model=list[UserResponse])
def list_users(
    role: str | None = Query(default=None),
    status_filter: str | None = Query(default=None, alias="status"),
    search: str | None = Query(default=None),
    limit: int = Query(default=50, ge=1, le=200),
    db: Session = Depends(get_db),
    current_user: User = Depends(require_permission("users.view")),
):
    statement = select(User).order_by(User.id)
    if role is not None:
        statement = statement.where(User.role == normalize_role(role))
    if status_filter is not None:
        statement = statement.where(User.status == status_filter)
    if search:
        search_pattern = f"%{search}%"
        statement = statement.where(User.username.ilike(search_pattern) | User.full_name.ilike(search_pattern))
    statement = statement.limit(limit)
    return list(db.scalars(statement).all())


@router.post("", response_model=UserResponse, status_code=status.HTTP_201_CREATED)
def create_user(
    payload: UserCreate,
    db: Session = Depends(get_db),
    current_user: User = Depends(require_permission("users.manage")),
):
    role = validate_role(payload.role)
    existing = db.scalar(select(User).where(User.username == payload.username))
    if existing is not None:
        raise HTTPException(status_code=409, detail="Username already exists")

    now = datetime.now(timezone.utc)
    user = User(
        username=payload.username,
        password_hash=hash_password(payload.password),
        full_name=payload.full_name,
        role=role,
        status="active",
        created_at=now,
        updated_at=now,
        last_login_at=None,
    )
    db.add(user)
    db.flush()

    if role == "patient":
        if payload.patient_id is None:
            db.rollback()
            raise HTTPException(status_code=400, detail="patient_id is required for a patient portal account")
        ensure_patient_link(db, user.id, payload.patient_id)
    elif payload.patient_id is not None:
        db.rollback()
        raise HTTPException(status_code=400, detail="patient_id can only be set for a patient portal account")

    db.commit()
    db.refresh(user)
    return serialize_user(user, db)


@router.get("/{user_id}", response_model=UserResponse)
def get_user(
    user_id: int,
    db: Session = Depends(get_db),
    current_user: User = Depends(require_permission("users.view")),
):
    user = db.get(User, user_id)
    if user is None:
        raise HTTPException(status_code=status.HTTP_404_NOT_FOUND, detail="User not found")
    return serialize_user(user, db)


@router.put("/{user_id}", response_model=UserResponse)
def update_user(
    user_id: int,
    payload: UserUpdate,
    db: Session = Depends(get_db),
    current_user: User = Depends(require_permission("users.manage")),
):
    user = db.get(User, user_id)
    if user is None:
        raise HTTPException(status_code=404, detail="User not found")

    data = payload.model_dump(exclude_unset=True)
    role = validate_role(data["role"]) if "role" in data and data["role"] is not None else normalize_role(user.role)

    if "username" in data and data["username"] != user.username:
        duplicate = db.scalar(select(User).where(User.username == data["username"], User.id != user_id))
        if duplicate:
            raise HTTPException(status_code=409, detail="Username already exists")
        user.username = data["username"]
    if "full_name" in data and data["full_name"] is not None:
        user.full_name = data["full_name"]
    if "password" in data and data["password"]:
        user.password_hash = hash_password(data["password"])
    user.role = role

    if role == "patient":
        patient_id = data.get("patient_id", resolve_patient_link(db, user.id))
        if patient_id is None:
            raise HTTPException(status_code=400, detail="patient_id is required for a patient portal account")
        ensure_patient_link(db, user.id, patient_id)
    elif "patient_id" in data and data["patient_id"] is not None:
        raise HTTPException(status_code=400, detail="patient_id can only be set for a patient portal account")
    else:
        ensure_patient_link(db, user.id, None)

    user.updated_at = datetime.now(timezone.utc)
    db.commit()
    db.refresh(user)
    return serialize_user(user, db)


@router.put("/{user_id}/status", response_model=UserResponse)
def update_user_status(
    user_id: int,
    payload: UserStatusUpdate,
    db: Session = Depends(get_db),
    current_user: User = Depends(require_permission("users.manage")),
):
    allowed_statuses = {"active", "inactive", "suspended"}
    if payload.status not in allowed_statuses:
        raise HTTPException(status_code=status.HTTP_400_BAD_REQUEST, detail="Invalid user status")

    user = db.get(User, user_id)
    if user is None:
        raise HTTPException(status_code=status.HTTP_404_NOT_FOUND, detail="User not found")

    user.status = payload.status
    user.updated_at = datetime.now(timezone.utc)
    db.commit()
    db.refresh(user)
    return serialize_user(user, db)
